    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.6",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.1",
    "supertest": "^7.3.1",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.2",
